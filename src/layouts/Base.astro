---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light;
        --ink: #19231e;
        --muted: #65736b;
        --paper: #fffdf7;
        --surface: #ffffff;
        --accent: #c54f35;
        --accent-dark: #963823;
        --accent-soft: #f9e2d8;
        --leaf: #315c48;
        --border: #d9ddd5;
        --shadow: 0 1.5rem 4rem rgb(38 51 43 / 12%);
        --radius: 1rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body {
        font-family: var(--font-body);
        line-height: 1.5;
        min-height: 100vh;
        max-width: 54rem;
        margin: 0 auto;
        padding: 4rem 1.25rem 3rem;
        color: var(--ink);
        background:
          radial-gradient(circle at 15% 0%, rgb(197 79 53 / 13%), transparent 28rem),
          radial-gradient(circle at 100% 25%, rgb(49 92 72 / 10%), transparent 25rem),
          var(--paper);
      }
      header {
        max-width: 46rem;
        margin: 0 auto 2rem;
        text-align: center;
      }
      h1 {
        margin: 0 0 0.65rem;
        font-family: var(--font-head);
        font-size: clamp(2rem, 7vw, 3.35rem);
        line-height: 1.05;
        letter-spacing: -0.045em;
      }
      .tagline { max-width: 40rem; margin: 0 auto; color: var(--muted); font-size: 1rem; }
      code { font-family: var(--font-body); }
      .bookmark-card,
      .saved-section {
        padding: clamp(1.25rem, 4vw, 2rem);
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) + 0.35rem);
        background: color-mix(in srgb, var(--surface) 94%, transparent);
        box-shadow: var(--shadow);
      }
      .saved-section { margin-top: 1rem; box-shadow: none; }
      .section-heading h2 {
        margin: 0.15rem 0 0.4rem;
        font-family: var(--font-head);
        font-size: clamp(1.25rem, 4vw, 1.65rem);
        letter-spacing: -0.025em;
      }
      .section-heading > p:last-child { margin: 0; color: var(--muted); }
      .eyebrow {
        margin: 0;
        color: var(--accent-dark);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: end;
        margin: 1.5rem 0 0.6rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1 16rem; }
      label { font-size: 0.8rem; font-weight: 700; }
      input {
        min-height: 3rem;
        padding: 0.7rem 0.85rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font: inherit;
        background: var(--surface);
        color: inherit;
      }
      input::placeholder { color: #8a958e; }
      input:focus-visible,
      button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      button {
        min-height: 3rem;
        padding: 0.7rem 1.1rem;
        border: 1px solid transparent;
        border-radius: var(--radius);
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { background: var(--accent-dark); }
      .hint { margin: 0; font-size: 0.78rem; color: var(--muted); }
      .hint code {
        padding: 0.05rem 0.25rem;
        border-radius: 0.25rem;
        background: var(--accent-soft);
        color: var(--accent-dark);
      }
      .status {
        margin: 0.85rem 0 0;
        padding: 0.65rem 0.75rem;
        border-radius: 0.65rem;
        font-size: 0.82rem;
      }
      .status[data-kind='error'] { background: #fff0ec; color: #8a2e1d; }
      .status[data-kind='success'] { background: #e9f4ed; color: #24543d; }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0 0 1rem;
      }
      .list-title { margin: 0.15rem 0 0; font-size: 1.25rem; font-family: var(--font-head); }
      .clear {
        min-height: auto;
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-dark); }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 0.75rem;
        padding: 0.85rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
      }
      .bookmark-value { flex: 1 1 18rem; min-width: 0; margin: 0; overflow-wrap: anywhere; }
      .bookmark .url { color: var(--leaf); font-weight: 600; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
      .bookmark .slug {
        font-family: var(--font-body);
        font-size: 0.85rem;
        padding: 0.15rem 0.4rem;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-dark);
      }
      .bookmark .copy {
        min-height: auto;
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .bookmark .copy:hover { background: #edf4f0; border-color: var(--leaf); color: var(--leaf); }
      .empty {
        margin: 0;
        padding: 2rem 1.5rem;
        text-align: center;
        color: var(--muted);
        border: 1px dashed var(--border);
        border-radius: var(--radius);
      }
      .empty span { display: block; margin-bottom: 0.35rem; color: var(--accent); font-size: 1.25rem; }

      footer { margin-top: 1.5rem; text-align: center; font-size: 0.75rem; color: var(--muted); }
      @media (max-width: 35rem) {
        body { padding-top: 2.5rem; }
        form button { width: 100%; }
        li.bookmark { align-items: stretch; }
        .bookmark .copy { width: 100%; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
