<section class="bookmark-card" aria-labelledby="bookmark-form-title">
  <div class="section-heading">
    <p class="eyebrow">Your private link shelf</p>
    <h2 id="bookmark-form-title">Save something worth returning to</h2>
    <p>Enter a web address and Mona will pair it with a compact, memorable slug.</p>
  </div>

  <form id="add-bookmark" novalidate>
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="off"
        spellcheck="false"
        placeholder="example.com/article"
        aria-describedby="url-hint form-status"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p id="url-hint" class="hint">With or without <code>https://</code> — Mona will normalize it for you.</p>
  <p id="form-status" class="status" role="status" aria-live="polite" hidden></p>
</section>

<section class="saved-section" aria-labelledby="saved-title">
  <div id="list-header" hidden>
    <div>
      <p class="eyebrow">Mona's collection</p>
      <h2 id="saved-title" class="list-title">Saved bookmarks</h2>
    </div>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <p id="empty-state" class="empty">
    <span aria-hidden="true">✦</span>
    No bookmarks yet. Your first saved link will appear here.
  </p>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import {
    createUniqueSlug,
    formatBookmark,
    normalizeUrl,
    parseStoredBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const urlInput = document.querySelector<HTMLInputElement>('#url');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');
  const emptyState = document.querySelector<HTMLParagraphElement>('#empty-state');
  const listHeader = document.querySelector<HTMLElement>('#list-header');
  const bookmarkList = document.querySelector<HTMLUListElement>('#bookmark-list');
  const clearButton = document.querySelector<HTMLButtonElement>('#clear-all');
  let bookmarks: Bookmark[] = [];

  function showStatus(message: string, kind: 'error' | 'success'): void {
    if (!status) return;
    status.textContent = message;
    status.dataset.kind = kind;
    status.hidden = false;
  }

  function clearStatus(): void {
    if (!status) return;
    status.textContent = '';
    status.hidden = true;
    delete status.dataset.kind;
  }

  function renderBookmarks(): void {
    if (!bookmarkList || !emptyState || !listHeader) return;

    bookmarkList.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const value = document.createElement('p');
      value.className = 'bookmark-value';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createTextNode(' :: ');
      const slug = document.createElement('code');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      value.append(link, separator, slug);

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy slug';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showStatus(`${bookmark.slug} copied to your clipboard.`, 'success');
        } catch {
          showStatus('Mona could not access your clipboard. Copy the slug directly instead.', 'error');
        }
      });

      item.append(value, copyButton);
      bookmarkList.append(item);
    }
  }

  function persist(nextBookmarks: readonly Bookmark[]): boolean {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(nextBookmarks));
      return true;
    } catch {
      showStatus('Mona could not save this bookmark. Check your browser storage settings and try again.', 'error');
      return false;
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!urlInput) return;

    clearStatus();
    try {
      const url = normalizeUrl(urlInput.value);
      const slug = createUniqueSlug(bookmarks, (length) => {
        return crypto.getRandomValues(new Uint8Array(length));
      });
      const nextBookmarks = [...bookmarks, { url, slug }];

      if (!persist(nextBookmarks)) return;

      bookmarks = nextBookmarks;
      renderBookmarks();
      form.reset();
      showStatus(`Saved ${formatBookmark({ url, slug })}`, 'success');
      urlInput.focus();
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Mona could not save that URL.';
      showStatus(message, 'error');
      urlInput.focus();
    }
  });

  try {
    bookmarks = parseStoredBookmarks(localStorage.getItem(STORAGE_KEY));
  } catch {
    showStatus('Mona could not read saved bookmarks. You can still view this page and try again.', 'error');
  }
  renderBookmarks();

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all of Mona’s saved bookmarks?')) return;

    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      showStatus('Mona could not clear your bookmarks. Check your browser storage settings and try again.', 'error');
      return;
    }

    bookmarks = [];
    renderBookmarks();
    showStatus('All bookmarks cleared.', 'success');
  });
</script>
